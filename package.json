{
  "name": "ptt-crosslink",
  "version": "0.2.2",
  "private": true,
  "description": "TeamSpeak crosslink met tijdmelder, callgever, Channel Commander en omroepen van gebruikersnamen bij kanaalbinnenkomst",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/controller.test.cjs",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@honeybbq/teamspeak-client": "0.3.3",
    "opusscript": "0.1.1"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "nl.heerlen.pttcrosslink",
    "productName": "PTT-Crosslink",
    "asar": true,
    "asarUnpack": [
      "node_modules/opusscript/**"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "bridge/**",
      "ui/**",
      "tts_windows.ps1",
      "package.json",
      "node_modules/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "PTT-Crosslink-v${version}-Windows-x64.${ext}"
    },
    "extraResources": [
      {
        "from": "tts_windows.ps1",
        "to": "tts_windows.ps1"
      }
    ]
  }
}
